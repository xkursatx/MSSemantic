<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>UMAI Bilişim - Cemile</title>
    <style>
        body { max-width: 850px; margin: 2rem auto; padding: 0 1rem; font: 16px system-ui; background: #f5f7fb; color: #182230; }
        h1 { margin-bottom: .25rem; } .subtitle { color: #64748b; }
        .chat { background: white; padding: 1rem; border-radius: 12px; box-shadow: 0 4px 18px #0001; }
        .message { padding: .75rem 1rem; margin: .75rem 0; border-radius: 10px; white-space: pre-wrap; }
        .user { background: #e0f2fe; margin-left: 15%; } .assistant { background: #f1f5f9; margin-right: 15%; }
        textarea { width: 100%; box-sizing: border-box; min-height: 90px; padding: .75rem; margin-top: 1rem; }
        button { margin-top: .5rem; padding: .65rem 1.2rem; cursor: pointer; } .error { color: #b91c1c; }
        .playground-settings { margin: 1rem 0; padding: 1rem; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; }
        .playground-settings h2 { font-size: 1.1rem; margin: 0 0 .25rem; }
        .hint { color: #64748b; font-size: .9rem; }
        .settings-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: .75rem 1rem; margin-top: .75rem; }
        .settings-grid label { display: grid; gap: .25rem; }
        output { color: #0f766e; font-weight: 600; }
        .settings-used { display: block; margin-top: .5rem; color: #64748b; font-size: .75rem; }
        .typing-indicator { display: inline-flex; gap: .25rem; padding: .5rem 0; }
        .typing-indicator i { width: .45rem; height: .45rem; border-radius: 50%; background: #64748b; animation: typing 1s infinite ease-in-out; }
        .typing-indicator i:nth-child(2) { animation-delay: .15s; } .typing-indicator i:nth-child(3) { animation-delay: .3s; }
        .typing-indicator[hidden] { display: none; }
        @@keyframes typing { 0%, 60%, 100% { opacity: .3; transform: translateY(0); } 30% { opacity: 1; transform: translateY(-3px); } }
        @@media (max-width: 600px) { .settings-grid { grid-template-columns: 1fr; } }
    </style>
</head>
<body>@RenderBody()</body>
</html>
