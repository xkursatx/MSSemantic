<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>UMAI Bilişim - Cemile</title>
    <style>
        body { max-width: 850px; margin: 2rem auto; padding: 0 1rem; font: 16px system-ui; background: #f5f7fb; color: #182230; }
        h1 { margin-bottom: .25rem; } .subtitle { color: #64748b; }
        .chat { background: white; padding: 1rem; border-radius: 12px; box-shadow: 0 4px 18px #0001; }
        .message { padding: .75rem 1rem; margin: .75rem 0; border-radius: 10px; white-space: pre-wrap; }
        .user { background: #e0f2fe; margin-left: 15%; } .assistant { background: #f1f5f9; margin-right: 15%; }
        textarea { width: 100%; box-sizing: border-box; min-height: 90px; padding: .75rem; margin-top: 1rem; }
        button { margin-top: .5rem; padding: .65rem 1.2rem; cursor: pointer; } .error { color: #b91c1c; }
    </style>
</head>
<body>@RenderBody()</body>
</html>
